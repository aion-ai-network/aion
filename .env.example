# Local development values only.
POSTGRES_BOOTSTRAP_PASSWORD=local_bootstrap_password
AION_DB_HOST=127.0.0.1
AION_DB_PORT=5432
AION_DB_NAME=aion
AION_DB_USER=aion_runtime
AION_DB_PASSWORD=local_runtime_password
AION_DB_MIGRATION_USER=aion_migrator
AION_DB_MIGRATION_PASSWORD=local_migration_password
AION_REDIS_URL=redis://127.0.0.1:6379/0
AION_RESULT_BACKEND=redis://127.0.0.1:6379/1
AION_ENVIRONMENT=development
AION_LOG_LEVEL=INFO
AION_API_PORT=8000
AION_WEB_PORT=5173
AION_REDIS_PORT=6379
AION_PUBLIC_ORIGIN=http://127.0.0.1:5173
AION_SESSION_TTL_SECONDS=604800
AION_SCHEDULER_INTERVAL_SECONDS=10
AION_HEARTBEAT_MAX_AGE_SECONDS=45

# External services remain disabled until configured. Never commit real credentials.
AION_STORAGE_BACKEND=local
AION_STORAGE_PATH=.data/private
AION_S3_ENDPOINT=
AION_S3_REGION=us-east-1
AION_S3_BUCKET=aion-private
AION_S3_ACCESS_KEY=
AION_S3_SECRET_KEY=
AION_LLM_ENABLED=false
AION_LLM_BASE_URL=https://api.openai.com/v1
AION_LLM_MODEL=
AION_LLM_API_KEY=
AION_LLM_DAILY_BUDGET_USD=1
# Set conservative prices for the selected model before enabling it.
AION_LLM_INPUT_USD_PER_MILLION=10
AION_LLM_OUTPUT_USD_PER_MILLION=40
AION_STT_ENABLED=false
AION_STT_BASE_URL=https://api.openai.com/v1
AION_STT_MODEL=
AION_STT_API_KEY=
AION_STT_GLOBAL_DAILY_SECONDS=3600
AION_TELEGRAM_BOT_TOKEN=
AION_TELEGRAM_BOT_USERNAME=
AION_TELEGRAM_WEBHOOK_SECRET=
AION_VAPID_PUBLIC_KEY=
AION_VAPID_PRIVATE_KEY=
AION_VAPID_SUBJECT=
# Production only: AION_DOMAIN=aion.example.com and HTTPS AION_PUBLIC_ORIGIN.
